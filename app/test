import React, { useMemo, useState } from "react";

// ====== AI Diet Generator — Diet Dash Themed (Green Hero) ======
// Drop this file into Next.js as app/page.tsx (or pages/index.tsx)
// Tailwind required. Palette tuned to green accents like your landing (btns, headings).

function NumberField({ label, value, onChange, min = 0, step = 1, placeholder }: {
  label: string;
  value: number | undefined;
  onChange: (v: number) => void;
  min?: number;
  step?: number;
  placeholder?: string;
}) {
  return (
    <label className="flex flex-col gap-1 text-sm">
      <span className="text-gray-700">{label}</span>
      <input
        type="number"
        className="w-full rounded-2xl border border-gray-200 bg-white px-4 py-2 shadow-sm outline-none focus:border-green-500"
        value={value === undefined ? "" : value}
        onChange={(e) => onChange(Number(e.target.value))}
        min={min}
        step={step}
        placeholder={placeholder}
      />
    </label>
  );
}

export default function DietDashAIDietGenerator() {
  const [gender, setGender] = useState<"Мужчина" | "Женщина" | "">("");
  const [age, setAge] = useState<number>();
  const [height, setHeight] = useState<number>();
  const [weight, setWeight] = useState<number>();

  const [targetCalories, setTargetCalories] = useState<number>();
  const [protein, setProtein] = useState<number>();
  const [carbs, setCarbs] = useState<number>();
  const [fat, setFat] = useState<number>();

  const [mealsCount, setMealsCount] = useState<number>(4);
  const [comments, setComments] = useState<string>("");

  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [result, setResult] = useState<any>(null);

  const isValid = useMemo(() => {
    return (
      gender !== "" &&
      !!age && age > 0 &&
      !!height && height > 0 &&
      !!weight && weight > 0 &&
      !!targetCalories && targetCalories > 500 &&
      !!protein && protein > 0 &&
      !!carbs && carbs > 0 &&
      !!fat && fat > 0 &&
      !!mealsCount && mealsCount > 0
    );
  }, [gender, age, height, weight, targetCalories, protein, carbs, fat, mealsCount]);

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault();
    if (!isValid) return;
    setIsLoading(true);
    setError(null);
    setResult(null);

    try {
      const payload = {
        gender,
        age,
        height_cm: height,
        weight_kg: weight,
        target: {
          calories: targetCalories,
          protein_g: protein,
          carbs_g: carbs,
          fat_g: fat,
        },
        mealsCount,
        comments,
      };

      const res = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg || "Generation failed");
      }

      const data = await res.json();
      setResult(data);
    } catch (err: any) {
      setError(err?.message || "Unknown error");
    } finally {
      setIsLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-white text-gray-900">
      {/* HERO */}
      <section className="relative isolate overflow-hidden">
        <div className="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 px-4 pb-12 pt-10 sm:px-6 md:grid-cols-2 md:pb-16 md:pt-16 lg:gap-12 lg:px-8">
          <div>
            <h1 className="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
              <span className="block">Boost Your Efficiency as</span>
              <span className="block text-green-800">a Nutritionist</span>
              <span className="block">Automate Diet Planning Today</span>
            </h1>
            <p className="mt-4 max-w-xl text-base leading-relaxed text-gray-700">
              Save hours on calculations, create personalized plans, and manage clients with our all‑in‑one platform.
            </p>
            <div className="mt-6 flex flex-wrap gap-3">
              <a href="#generator" className="inline-flex items-center justify-center rounded-full bg-green-700 px-5 py-2.5 text-sm font-semibold text-white shadow hover:bg-green-800">FREE GUIDE TO START</a>
              <a href="#generator" className="inline-flex items-center justify-center rounded-full bg-green-100 px-5 py-2.5 text-sm font-semibold text-green-800 shadow-inner hover:bg-green-200">GO TO THE PLATFORM</a>
            </div>
          </div>
          <div className="relative">
            <div className="pointer-events-none select-none rounded-[2rem] border border-green-100 bg-gradient-to-br from-green-50 to-white p-2 shadow-sm">
              <img src="/hero-salad.jpg" alt="Fresh salad" className="h-[420px] w-full rounded-[1.75rem] object-cover" />
            </div>
          </div>
        </div>
      </section>

      {/* GENERATOR */}
      <section id="generator" className="border-t border-gray-100 bg-gradient-to-b from-white to-green-50/40">
        <div className="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
          <div className="grid gap-6 md:grid-cols-2">
            {/* Form */}
            <div className="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm">
              <div className="mb-4 flex items-center gap-2">
                <div className="h-9 w-9 rounded-xl bg-green-700/10 text-green-700 ring-1 ring-green-700/20 flex items-center justify-center font-semibold">AI</div>
                <h2 className="text-lg font-semibold">AI Diet Generator</h2>
              </div>
              <form className="grid grid-cols-1 gap-4" onSubmit={onSubmit}>
                <div className="grid grid-cols-2 gap-4">
                  <label className="flex flex-col gap-1 text-sm">
                    <span className="text-gray-700">Пол</span>
                    <select
                      className="w-full rounded-2xl border border-gray-200 bg-white px-4 py-2 shadow-sm outline-none focus:border-green-500"
                      value={gender}
                      onChange={(e) => setGender(e.target.value as any)}
                    >
                      <option value="">— выбери —</option>
                      <option value="Мужчина">Мужчина</option>
                      <option value="Женщина">Женщина</option>
                    </select>
                  </label>
                  <NumberField label="Возраст" value={age} onChange={setAge} min={10} />
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <NumberField label="Рост (см)" value={height} onChange={setHeight} min={100} />
                  <NumberField label="Вес (кг)" value={weight} onChange={setWeight} min={30} step={0.1} />
                </div>

                <div className="rounded-2xl bg-green-50/60 p-4 ring-1 ring-inset ring-green-100">
                  <h3 className="mb-3 text-sm font-medium text-gray-700">Целевые значения</h3>
                  <div className="grid grid-cols-2 gap-4">
                    <NumberField label="Калораж (ккал/день)" value={targetCalories} onChange={setTargetCalories} min={900} />
                    <NumberField label="Белки (г/день)" value={protein} onChange={setProtein} min={10} />
                  </div>
                  <div className="mt-3 grid grid-cols-2 gap-4">
                    <NumberField label="Углеводы (г/день)" value={carbs} onChange={setCarbs} min={10} />
                    <NumberField label="Жиры (г/день)" value={fat} onChange={setFat} min={10} />
                  </div>
                </div>

                <NumberField label="Приёмов пищи в день" value={mealsCount} onChange={setMealsCount} min={1} />

                <label className="flex flex-col gap-1 text-sm">
                  <span className="text-gray-700">Комментарии / предпочтения</span>
                  <textarea
                    className="min-h-[100px] w-full rounded-2xl border border-gray-200 bg-white px-4 py-2 shadow-sm outline-none focus:border-green-500"
                    placeholder="Например: без рыбы; добавь курицу; 4 яйца каждый день; 2.5 л воды; без лактозы и т.д."
                    value={comments}
                    onChange={(e) => setComments(e.target.value)}
                  />
                </label>

                <div className="mt-2 flex items-center justify-between gap-3">
                  <button
                    disabled={!isValid || isLoading}
                    className="rounded-full bg-green-700 px-5 py-2.5 text-white shadow-sm transition hover:bg-green-800 disabled:cursor-not-allowed disabled:opacity-50"
                    type="submit"
                  >
                    {isLoading ? "Генерирую…" : "Сгенерировать план"}
                  </button>
                  <p className="text-xs text-gray-500">Данные не сохраняются без вашего согласия.</p>
                </div>

                {error && (
                  <div className="rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-700">{error}</div>
                )}
              </form>
            </div>

            {/* Result */}
            <div className="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm">
              <h2 className="mb-3 text-lg font-semibold">Результат</h2>
              {!result && (
                <p className="text-sm text-gray-500">Сгенерируйте план, чтобы увидеть здесь JSON с калоражем, БЖУ и блюдами. После интеграции с PDF вы сможете скачивать готовый файл.</p>
              )}
              {result && (
                <div className="space-y-4">
                  <div className="grid grid-cols-3 gap-3">
                    <div className="rounded-xl bg-green-50 p-3 text-sm ring-1 ring-inset ring-green-100">
                      <div className="text-gray-500">Калораж</div>
                      <div className="text-lg font-semibold">{result.dailyCalories} ккал</div>
                    </div>
                    <div className="rounded-xl bg-green-50 p-3 text-sm ring-1 ring-inset ring-green-100">
                      <div className="text-gray-500">Белки / Углеводы / Жиры</div>
                      <div className="text-lg font-semibold">{result?.macros?.protein} / {result?.macros?.carbs} / {result?.macros?.fat} г</div>
                    </div>
                    {typeof result.estimatedCostEUR === "number" && (
                      <div className="rounded-xl bg-green-50 p-3 text-sm ring-1 ring-inset ring-green-100">
                        <div className="text-gray-500">Оценка стоимости</div>
                        <div className="text-lg font-semibold">≈ €{Number(result.estimatedCostEUR).toFixed(2)} / день</div>
                      </div>
                    )}
                  </div>

                  <div className="overflow-hidden rounded-2xl border border-gray-100">
                    <table className="w-full table-auto text-left text-sm">
                      <thead className="bg-gray-50 text-gray-600">
                        <tr>
                          <th className="px-3 py-2">Приём</th>
                          <th className="px-3 py-2">Продукт</th>
                          <th className="px-3 py-2">Кол-во</th>
                          <th className="px-3 py-2">Ккал</th>
                          <th className="px-3 py-2">Б / У / Ж</th>
                        </tr>
                      </thead>
                      <tbody>
                        {result.meals?.map((meal: any, i: number) => (
                          <React.Fragment key={i}>
                            {meal.items?.map((it: any, j: number) => (
                              <tr key={`${i}-${j}`} className="border-t border-gray-100">
                                <td className="px-3 py-2 align-top font-medium text-gray-800">{j === 0 ? meal.name : ""}</td>
                                <td className="px-3 py-2">{it.product}</td>
                                <td className="px-3 py-2">{it.amount}</td>
                                <td className="px-3 py-2">{typeof it.calories === "number" ? Math.round(it.calories) : it.calories}</td>
                                <td className="px-3 py-2">{it.protein ?? "-"} / {it.carbs ?? "-"} / {it.fat ?? "-"}</td>
                              </tr>
                            ))}
                          </React.Fragment>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  {result.notes && (
                    <div className="rounded-xl bg-green-50 p-3 text-sm ring-1 ring-inset ring-green-100 text-gray-700">
                      <div className="mb-1 font-medium">Заметки</div>
                      <p>{result.notes}</p>
                    </div>
                  )}

                  {result.pdfUrl && (
                    <a
                      href={result.pdfUrl}
                      target="_blank"
                      rel="noreferrer"
                      className="inline-block rounded-full bg-green-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-800"
                    >
                      Скачать PDF
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>

          <p className="mt-8 text-center text-xs text-gray-400">© {new Date().getFullYear()} Diet Dash — AI Diet Generator</p>
        </div>
      </section>
    </main>
  );
}
